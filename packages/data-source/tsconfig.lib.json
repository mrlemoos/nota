{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"],
  "references": [
    {
      "path": "../notes-offline-core/tsconfig.lib.json"
    },
    {
      "path": "../notes-offline/tsconfig.lib.json"
    },
    {
      "path": "../env-nextjs/tsconfig.lib.json"
    },
    {
      "path": "../database-types/tsconfig.lib.json"
    }
  ]
}
